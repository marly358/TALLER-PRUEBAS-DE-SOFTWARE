{
  "name": "qa-cineflex-project",
  "version": "1.0.0",
  "private": true,
  "description": "Taller integrador QA - CineFlex",
  "engines": { "node": ">=24.0.0" },
  "workspaces": ["backend"],
  "scripts": {
    "start": "npm start --workspace backend",
    "dev": "npm run dev --workspace backend",
    "test": "node --test backend/tests/*.test.js",
    "test:api": "node scripts/run-suite.js api",
    "test:ui": "node scripts/run-suite.js ui",
    "test:all": "npm test && npm run test:api && npm run test:ui",
    "test:performance": "node scripts/run-suite.js performance"
  },
  "devDependencies": {
    "newman": "^6.2.1",
    "selenium-webdriver": "^4.28.1"
  }
}
